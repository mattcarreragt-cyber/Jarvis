# ─── Core (Unraid) ────────────────────────────────────────────────────────────
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jarvis
DATABASE_URL=postgresql+asyncpg://jarvis:changeme@postgres:5432/jarvis

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333

# ─── Compute node (Kubuntu) ───────────────────────────────────────────────────
KUBUNTU_URL=http://192.168.1.XX:11434      # URL de santé Kubuntu (port Ollama)
KUBUNTU_MAC=AA:BB:CC:DD:EE:FF             # Adresse MAC pour Wake-on-LAN
KUBUNTU_WOL_ENABLED=true
KUBUNTU_WOL_TIMEOUT=60                     # secondes max d'attente après WoL

OLLAMA_BASE_URL=http://192.168.1.XX:11434
COMFYUI_BASE_URL=http://192.168.1.XX:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors   # nom du modèle SDXL dans ComfyUI
WHISPER_BASE_URL=http://192.168.1.XX:9000
PIPER_BASE_URL=http://unraid-piper:5000    # Piper tourne sur Unraid (CPU)

# ─── Dashboard ────────────────────────────────────────────────────────────────
HOST_IP=192.168.1.XX       # IP de ton serveur Unraid sur le LAN

# ─── API ──────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-generate-a-real-secret
API_KEY=changeme-generate-a-real-api-key  # partagé avec le dashboard
API_PORT=8000
LOG_LEVEL=info

# ─── Home Assistant ────────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123   # ou IP
HA_TOKEN=                                 # token longue durée HA (Profil → Sécurité)

# ─── RunPod (3e palier : GPU cloud pour gros modèles) ───────────────────────────
RUNPOD_ENABLED=false
RUNPOD_API_KEY=                           # clé API RunPod (Settings → API Keys)
RUNPOD_POD_ID=                            # id du pod à démarrer/arrêter à la demande
RUNPOD_OLLAMA_URL=                        # ex. https://xxxx-11434.proxy.runpod.net
RUNPOD_COMFYUI_URL=                       # ex. https://xxxx-8188.proxy.runpod.net
RUNPOD_START_TIMEOUT=300                  # s max d'attente au démarrage du pod

# ─── Nextcloud (RAG local) ──────────────────────────────────────────────────────
NEXTCLOUD_URL=                            # ex. http://192.168.1.50:8080 (SANS /remote.php)
NEXTCLOUD_USER=                           # ton utilisateur Nextcloud
NEXTCLOUD_PASSWORD=                       # app password (Paramètres → Sécurité)
NEXTCLOUD_ROOT=/                          # "/" = tout Nextcloud, ou "/Documents"
NEXTCLOUD_SYNC_ENABLED=false              # true pour activer la sync périodique
NEXTCLOUD_SYNC_INTERVAL=3600              # secondes entre deux syncs (min 60)
NEXTCLOUD_MAX_FILE_MB=50                  # ignore les fichiers plus gros
