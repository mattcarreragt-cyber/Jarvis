{
  "_comment": "Template vidéo HD pour le palier RunPod (gros GPU). Memes tokens que le template local : __PROMPT__, __NEG__, __FRAMES__, __FPS__. Ici en 768x768 avec plus d'etapes. REMPLACE ce fichier par l'export API d'un workflow ComfyUI haut de gamme sur ton pod RunPod (ex. LTX-Video, Hunyuan Video, CogVideoX) en gardant les tokens aux bons endroits.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "v1-5-pruned-emaonly.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEG__", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 768, "batch_size": "__FRAMES__" }
  },
  "5": {
    "class_type": "ADE_StandardUniformContextOptions",
    "inputs": {
      "context_length": 16,
      "context_stride": 1,
      "context_overlap": 4,
      "fuse_method": "pyramid",
      "use_on_equal_length": false,
      "start_percent": 0.0,
      "guarantee_steps": 1
    }
  },
  "6": {
    "class_type": "ADE_AnimateDiffLoaderGen1",
    "inputs": {
      "model": ["1", 0],
      "model_name": "mm_sd_v15_v2.ckpt",
      "beta_schedule": "autoselect",
      "context_options": ["5", 0]
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 8.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["6", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["1", 2] }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": "__FPS__",
      "loop_count": 0,
      "filename_prefix": "jarvis_video_hd",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
